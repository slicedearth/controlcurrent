---
import { selectedSnapshot } from "../data";
import { browserNames } from "../format";
import { BROWSER_IDS } from "../browsers";
import { SECURITY_CONTROLS } from "../catalogue";
import SourceContext from "./SourceContext.astro";
import PlanLibrary from "./PlanLibrary.astro";

const browsers = BROWSER_IDS;
const controlCategories = [...new Set(SECURITY_CONTROLS.map((control) => control.category))];
const defaultRequiredControls = new Set([
  "content-security-policy",
  "strict-transport-security",
  "x-content-type-options",
  "referrer-policy",
  "samesite-cookies"
]);
---

<section id="browser-plan" class="planner-panel" aria-labelledby="planner-heading">
  <div class="planner-intro">
    <span class="eyebrow">Step 1</span>
    <h2 id="planner-heading">Choose your browsers</h2>
    <p>
      Include each browser you support and choose its oldest accepted version. These are your policy
      choices; ControlCurrent does not detect the browser you are using.
    </p>
  </div>

  <SourceContext />

  <details class="guided-example">
    <summary>First visit? Try a worked example.</summary>
    <div class="guided-example__body">
      <div>
        <h3>Chrome 120, Firefox 115, and Safari 17</h3>
        <p>
          Select <strong>Load example</strong>, then <strong>Check support</strong>. Results are
          grouped into features that are ready, need care, are not supported, or do not have enough
          browser data.
        </p>
      </div>
      <ol>
        <li>
          <strong>Choose:</strong> load the three example browser minimums.
        </li>
        <li>
          <strong>Read:</strong> open “Why?” to see the browser-specific evidence.
        </li>
        <li>
          <strong>Act:</strong> follow the next step and keep the stated fallback.
        </li>
      </ol>
    </div>
  </details>

  <form id="profile-form" class="profile-form">
    <label class="profile-name">
      <span>Profile name</span>
      <input name="profile-name" type="text" maxlength="80" value="Deployment profile" />
    </label>
    <div class="baseline-grid">
      {browsers.map((browser) => {
        const releases = [...selectedSnapshot.browsers[browser].releases]
          .filter((release) => ["current", "esr", "retired"].includes(release.status))
          .reverse();
        return (
          <div class="baseline-card" role="group" aria-labelledby={`browser-${browser}`}>
            <h3 id={`browser-${browser}`}>{browserNames[browser]}</h3>
            <label class="toggle-row">
              <input type="checkbox" name={`include-${browser}`} />
              <span>Include</span>
            </label>
            <label class="baseline-version">
              <span>Minimum version</span>
              <select name={`version-${browser}`} disabled>
                {releases.map((release) => (
                  <option value={release.version}>
                    {release.version}
                    {release.status === "current"
                      ? " · current"
                      : release.status === "esr"
                        ? " · ESR"
                        : ""}
                  </option>
                ))}
              </select>
            </label>
          </div>
        );
      })}
    </div>
    <div class="button-row">
      <button type="submit" class="button button--primary">
        Check support
      </button>
      <button type="button" class="button" id="load-example">
        Load example
      </button>
      <button type="button" class="button" id="save-profile">
        Save locally
      </button>
      <button type="button" class="button" id="clear-profile">
        Delete saved plan
      </button>
      <button type="button" class="button" id="export-profile" disabled>
        Export JSON
      </button>
      <button type="button" class="button" id="export-engineering-report" disabled>
        Export readable report
      </button>
    </div>
    <div class="profile-file-grid">
      <label>
        <span>Import a saved plan or result</span>
        <input id="import-profile" type="file" accept="application/json,.json" />
      </label>
      <label>
        <span>Compare with an earlier result</span>
        <input id="compare-profile" type="file" accept="application/json,.json" />
      </label>
      <label>
        <span>Import browser minimums from .browserslistrc or package.json</span>
        <input
          id="import-browser-config"
          type="file"
          accept=".browserslistrc,.json,application/json,text/plain"
        />
      </label>
      <label>
        <span>Import an existing ControlCurrent policy</span>
        <input id="import-policy" type="file" accept="application/json,.json" />
      </label>
    </div>
    <label class="toggle-row remember-result">
      <input id="remember-result" type="checkbox" />
      <span>
        Remember the latest result on this device so ControlCurrent can compare it after browser
        data updates.
      </span>
    </label>
    <p id="profile-message" class="form-message" role="status" aria-live="polite"></p>
  </form>

  <PlanLibrary />

  <section id="profile-results" class="profile-results" aria-labelledby="results-heading" hidden>
    <div class="section-heading">
      <div>
        <span class="eyebrow">Your result</span>
        <h2 id="results-heading">What your browser choices can support</h2>
      </div>
      <p id="results-source"></p>
    </div>
    <aside id="profile-update" class="update-notice" aria-live="polite" hidden></aside>
    <div class="button-row plan-handoffs">
      <a id="plan-to-compare" class="button" href="#">
        Try changes to this plan
      </a>
      <a id="plan-to-inspect" class="button" href="#">
        Inspect headers with this plan
      </a>
    </div>
    <form id="result-filters" class="result-filters" aria-label="Filter support results">
      <label>
        <span>Search results</span>
        <input id="result-search" type="search" placeholder="For example CSP or cookies" />
      </label>
      <label>
        <span>Security area</span>
        <select id="result-category">
          <option value="">All areas</option>
          {controlCategories.map((category) => (
            <option value={category}>{category}</option>
          ))}
        </select>
      </label>
      <label>
        <span>Result type</span>
        <select id="result-outcome">
          <option value="">All results</option>
          <option value="ready">Ready to use</option>
          <option value="limited">Works with known limitations</option>
          <option value="unsupported">Not supported</option>
          <option value="unknown">Not enough information</option>
        </select>
      </label>
      <label class="toggle-row result-filter-toggle">
        <input id="result-blockers" type="checkbox" />
        <span>Show blockers only</span>
      </label>
      <button type="button" class="button" id="clear-result-filters">
        Clear filters
      </button>
    </form>
    <p id="result-filter-status" class="form-message" role="status" aria-live="polite"></p>
    <div id="results-list" class="result-groups"></div>

    <details class="policy-builder">
      <summary>Turn this result into a reviewable browser policy</summary>
      <div class="policy-builder__body">
        <div class="planner-intro">
          <span class="eyebrow">Optional engineering step</span>
          <h3>Choose what your project requires</h3>
          <p>
            Select required security features, decide how uncertain browser data should be handled,
            and record any temporary exceptions. The policy and report are generated on this device.
          </p>
        </div>
        <div class="button-row">
          <button type="button" class="button" id="select-policy-controls">
            Select all
          </button>
          <button type="button" class="button" id="clear-policy-controls">
            Clear selection
          </button>
        </div>
        <div class="control-choice-groups policy-control-groups">
          {controlCategories.map((category) => (
            <fieldset class="control-choice-group">
              <legend>{category}</legend>
              {SECURITY_CONTROLS.filter((control) => control.category === category).map(
                (control) => (
                  <label class="choice-row">
                    <input
                      type="checkbox"
                      name="required-control"
                      value={control.id}
                      checked={defaultRequiredControls.has(control.id)}
                    />
                    <span>{control.name}</span>
                  </label>
                )
              )}
            </fieldset>
          ))}
        </div>
        <div class="policy-rule-grid">
          <label>
            <span>Known browser limitations</span>
            <select id="policy-qualifications">
              <option value="review">Require review</option>
              <option value="fail">Fail the policy</option>
            </select>
          </label>
          <label>
            <span>Unknown or inconsistent browser data</span>
            <select id="policy-unknown">
              <option value="fail">Fail the policy</option>
              <option value="review">Require review</option>
            </select>
          </label>
          <label>
            <span>No precise browser-data mapping</span>
            <select id="policy-unsupported">
              <option value="fail">Fail the policy</option>
              <option value="review">Require review</option>
            </select>
          </label>
        </div>

        <fieldset class="exception-editor">
          <legend>Temporary exception</legend>
          <div class="exception-editor__fields">
            <label>
              <span>Security feature</span>
              <select id="exception-control">
                {SECURITY_CONTROLS.map((control) => (
                  <option value={control.id}>{control.name}</option>
                ))}
              </select>
            </label>
            <label>
              <span>Browser</span>
              <select id="exception-browser">
                <option value="">All selected browsers</option>
                {browsers.map((browser) => (
                  <option value={browser}>{browserNames[browser]}</option>
                ))}
              </select>
            </label>
            <label>
              <span>Result covered</span>
              <select id="exception-outcome">
                <option value="available_with_qualification">Known limitation</option>
                <option value="unknown">Unknown browser data</option>
                <option value="source_inconsistent">Inconsistent source data</option>
                <option value="unsupported_mapping">No precise mapping</option>
                <option value="unavailable">Not supported</option>
                <option value="removed">Removed browser support</option>
                <option value="available_unqualified">Available without qualification</option>
              </select>
            </label>
            <label>
              <span>Expiry date</span>
              <input id="exception-expiry" type="date" />
            </label>
            <label class="exception-reason">
              <span>Reason</span>
              <input
                id="exception-reason"
                type="text"
                minlength="8"
                maxlength="512"
                placeholder="Why this temporary exception is justified"
              />
            </label>
          </div>
          <button type="button" class="button" id="add-policy-exception">
            Add exception
          </button>
          <div id="policy-exceptions" class="exception-list"></div>
        </fieldset>

        <div class="button-row">
          <button type="button" class="button button--primary" id="preview-policy">
            Check policy
          </button>
          <button type="button" class="button" id="export-policy" disabled>
            Export policy JSON
          </button>
          <button type="button" class="button" id="export-decision-report" disabled>
            Export printable decision report
          </button>
        </div>
        <p id="policy-message" class="form-message" role="status" aria-live="polite"></p>
        <section
          id="policy-preview"
          class="policy-preview"
          aria-labelledby="policy-preview-heading"
          hidden
        >
          <h3 id="policy-preview-heading">Policy decision</h3>
          <div id="policy-summary" class="stats-grid"></div>
          <form id="policy-filters" class="result-filters" aria-label="Filter policy findings">
            <label>
              <span>Search policy findings</span>
              <input id="policy-search" type="search" placeholder="Feature, browser, or reason" />
            </label>
            <label>
              <span>Decision</span>
              <select id="policy-decision">
                <option value="">All decisions</option>
                <option value="pass">Pass</option>
                <option value="review">Require review</option>
                <option value="fail">Fail</option>
              </select>
            </label>
            <label class="toggle-row result-filter-toggle">
              <input id="policy-exceptions-only" type="checkbox" />
              <span>Show exception findings only</span>
            </label>
            <button type="button" class="button" id="clear-policy-filters">
              Clear filters
            </button>
          </form>
          <p id="policy-filter-status" class="form-message" role="status" aria-live="polite"></p>
          <div id="policy-findings" class="results-list policy-findings"></div>
          <details class="policy-output">
            <summary>Review the canonical policy JSON</summary>
            <pre id="policy-json" tabindex="0" aria-label="Generated policy JSON"></pre>
          </details>
          <section class="policy-handoff" aria-labelledby="policy-ci-heading">
            <span class="eyebrow">Engineering hand-off</span>
            <h4 id="policy-ci-heading">Check the exported policy in continuous integration</h4>
            <p id="policy-ci-context"></p>
            <pre id="policy-ci-command" tabindex="0" aria-label="Command-line policy check"></pre>
          </section>
          <section class="policy-handoff" aria-labelledby="decision-packet-heading">
            <span class="eyebrow">Optional two-part record</span>
            <h4 id="decision-packet-heading">Attach a privacy-reduced evidence result</h4>
            <p>
              Add either a reduced evidence report or a command-line evidence-policy result.
              ControlCurrent keeps browser availability and supplied configuration evidence as
              separate sections. It does not calculate a combined security score.
            </p>
            <label>
              <span>Evidence result JSON</span>
              <input id="decision-evidence" type="file" accept="application/json,.json" />
            </label>
            <p
              id="decision-evidence-status"
              class="form-message"
              role="status"
              aria-live="polite"
            ></p>
            <button type="button" class="button" id="export-decision-packet" disabled>
              Export two-part decision packet
            </button>
          </section>
        </section>
      </div>
    </details>
  </section>

  <section
    id="profile-comparison"
    class="profile-results"
    aria-labelledby="profile-comparison-heading"
    hidden
  >
    <div class="section-heading">
      <div>
        <span class="eyebrow">Changes</span>
        <h2 id="profile-comparison-heading">What changed since the earlier result</h2>
      </div>
      <p id="comparison-source"></p>
    </div>
    <div id="comparison-summary" class="stats-grid"></div>
    <div id="comparison-events" class="results-list"></div>
  </section>
</section>

<script>
  import { initialisePlanner } from "../controllers/planner";
  initialisePlanner(document, import.meta.env.BASE_URL);
</script>
