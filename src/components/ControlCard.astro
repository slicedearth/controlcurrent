---
import type { SecurityControl } from "../catalogue";
import type { ControlEvaluation } from "../contracts";
import { browserNames } from "../format";
import OutcomeBadge from "./OutcomeBadge.astro";

interface Props {
  control: SecurityControl;
  evaluations: readonly ControlEvaluation[];
}

const { control, evaluations } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const outcomes = evaluations.map((evaluation) => evaluation.outcome);
const supportGroup = outcomes.some((outcome) => ["unavailable", "removed"].includes(outcome))
  ? "unsupported"
  : outcomes.some((outcome) =>
        ["unknown", "unsupported_mapping", "source_inconsistent"].includes(outcome)
      )
    ? "unknown"
    : outcomes.some((outcome) => outcome === "available_with_qualification")
      ? "limited"
      : "ready";
const searchText = [
  control.name,
  control.shortName,
  control.summary,
  control.category,
  ...control.threatClasses
]
  .join(" ")
  .toLocaleLowerCase("en-AU");
---

<article
  class="control-card"
  data-control-card
  data-category={control.category}
  data-search={searchText}
  data-support-group={supportGroup}
>
  <div class="card-topline">
    <span class="category">{control.category}</span>
    <span class="mapping-count">
      {
        control.mappingState === "active"
          ? `${control.bcdPaths.length} browser data record${control.bcdPaths.length === 1 ? "" : "s"}`
          : "Browser data unavailable"
      }
    </span>
  </div>
  <h3>
    <a href={`${base}/controls/${control.id}/`}>
      {control.name}
      <span aria-hidden="true">↗</span>
    </a>
  </h3>
  <p>{control.summary}</p>
  <div class="mini-results" aria-label={`Current support summary for ${control.name}`}>
    {
      evaluations.map((evaluation) => (
        <span>
          <small>{browserNames[evaluation.browser]}</small>
          <OutcomeBadge outcome={evaluation.outcome} />
        </span>
      ))
    }
  </div>
</article>
