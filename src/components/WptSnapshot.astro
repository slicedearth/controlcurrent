---
import input from "../../data/wpt-snapshot.json";
import {
  wptSnapshotSchema,
  WPT_SNAPSHOT_SUITES,
  WPT_STATUS_LABELS,
  selectWptSnapshot,
  summariseWptSuite,
  wptSnapshotQuery
} from "../wpt-snapshot";
import { formatDate } from "../format";
import type { WptEvidenceMapping } from "../wpt-evidence";
interface Props {
  mapping?: WptEvidenceMapping;
}
const { mapping } = Astro.props;
const snapshot = wptSnapshotSchema.parse(input);
const selection = selectWptSnapshot(snapshot, mapping);
const { suites } = selection;
const hasSelectedFiles = mapping?.suites.some((suite) => suite.tests);
---

{(suites.length > 0 || hasSelectedFiles) && (
  <section class="wpt-snapshot" aria-label="Retained public test results">
    <div class="section-heading">
      <div>
        <span class="eyebrow">A fixed result snapshot</span>
        <h2>What those browser runs reported</h2>
      </div>
      <p>Reviewed {formatDate(snapshot.reviewedOn)}</p>
    </div>
    <p>
      These are published results from specific stable-labelled browser builds. They are separate
      from the compatibility calculation and from evidence about your application. File outcomes and
      subtest counts stay separate. OK describes a completed harness, which can still contain
      failing subtests; Pass and Fail can also describe tests without a harness.
    </p>
    {hasSelectedFiles && (
      <div class="wpt-selection-scope">
        <p>
          <strong>Selected directive tests:</strong> {mapping?.scope}
        </p>
        <p>{mapping?.limitation}</p>
        <p>
          Counts cover every subtest reported by each selected file, including any setup or
          complementary cases. They are not isolated directive pass counts or application evidence.
        </p>
      </div>
    )}
    {selection.state === "revision_mismatch" && (
      <p role="status">
        Directive results are incomparable: the reviewed file selection and retained browser runs
        use different test-source revisions. No totals are substituted from the parent suite.
      </p>
    )}
    {selection.state === "not_retained" && (
      <p role="status">No results for this reviewed selection are retained in the snapshot.</p>
    )}
    <details class="content-card wpt-run-details">
      <summary>Exact browser builds, systems and source revision</summary>
      <ul>
        {snapshot.runs.map((run) => (
          <li>
            <strong>
              {run.browser} {run.browserVersion}
            </strong>{" "}
            · {run.os} {run.osVersion} · {run.channel}
            <br />
            <a href={`https://wpt.fyi/api/runs/${run.id}`} rel="noopener noreferrer">
              Run {run.id}
            </a>{" "}
            · {run.startedAt} to {run.completedAt}
            <br />
            <code class="source-path">{run.revision}</code>
          </li>
        ))}
      </ul>
      <p>
        “Stable” is the upstream run label. Complete runtime flags were not supplied by the summary
        API. These results do not cover every browser version, mobile platform or operating system.
      </p>
    </details>
    {suites.map(({ suite, retainedFiles, selectedFiles, missingFiles }) => (
      <article class="content-card wpt-suite">
        <h3>
          {mapping?.suites.find((source) => source.path === suite.path)?.label ??
            WPT_SNAPSHOT_SUITES.find((known) => known.path === suite.path)?.name}
        </h3>
        <code class="source-path">{suite.path}</code>
        {selectedFiles ? (
          <p>
            {suite.tests.length} of {selectedFiles.length} selected test files have retained
            results. The parent directory contains {retainedFiles} retained files from{" "}
            {suite.returnedTests} returned search matches. Only the exact files listed below enter
            these totals.
          </p>
        ) : (
          <p>
            {suite.tests.length} test files retained from {suite.returnedTests} returned search
            matches. Only this exact directory prefix is included. This is the returned result
            inventory, not a claim that every possible suite test ran.
          </p>
        )}
        {missingFiles.length > 0 && (
          <div class="wpt-missing-files">
            <p>
              Missing from the retained inventory; these files contribute no outcomes or subtests:
            </p>
            <ul>
              {missingFiles.map((path) => (
                <li>
                  <code class="source-path">{path}</code>
                </li>
              ))}
            </ul>
          </div>
        )}
        {suite.tests.length > 0 ? (
          <div
            class="table-wrap"
            role="region"
            aria-label={`${suite.path} retained totals`}
            tabindex="0"
          >
            <table>
              <thead>
                <tr>
                  <th scope="col">Browser build</th>
                  <th scope="col">Subtests passed / reported</th>
                  <th scope="col">File outcomes</th>
                </tr>
              </thead>
              <tbody>
                {snapshot.runs.map((run) => {
                  const summary = summariseWptSuite(suite, run.id);
                  return (
                    <tr>
                      <th scope="row">
                        {run.browser}
                        <br />
                        <small>{run.browserVersion}</small>
                      </th>
                      <td>
                        {summary.passes} / {summary.total}
                      </td>
                      <td>
                        {summary.statuses
                          .map((status) => `${status.count} ${status.label}`)
                          .join(" · ") || "No results"}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <p>
            No selected file results are available. This is an evidence gap, not a passing result.
          </p>
        )}
        <details class="wpt-file-results">
          <summary>Read all {suite.tests.length} retained file results</summary>
          <div
            class="table-wrap"
            role="region"
            aria-label={`${suite.path} individual file results`}
            tabindex="0"
          >
            <table>
              <thead>
                <tr>
                  <th scope="col">Test file</th>
                  {snapshot.runs.map((run) => (
                    <th scope="col">{run.browser}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {suite.tests.map((test) => (
                  <tr>
                    <th scope="row">
                      <code>{test.path.slice(suite.path.length + 2)}</code>
                    </th>
                    {snapshot.runs.map((run) => {
                      const result = test.results.find((entry) => entry.runId === run.id);
                      return (
                        <td>
                          {result
                            ? `${WPT_STATUS_LABELS[result.status]} · ${result.passes}/${result.total} subtests`
                            : "No result"}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
        <p class="source-actions">
          <a href={wptSnapshotQuery(suite, snapshot.runs)} rel="noopener noreferrer">
            {selectedFiles ? "Source API query (whole directory)" : "Pinned API query"}
          </a>
          <a
            href={`https://github.com/web-platform-tests/wpt/tree/${snapshot.runs[0]?.revision}/${suite.path}`}
            rel="noopener noreferrer"
          >
            Test source at the run revision
          </a>
        </p>
        <details>
          <summary>Source-response fingerprint</summary>
          <code class="source-path">SHA-256 {suite.responseSha256}</code>
          <p>
            The digest identifies the complete downloaded directory response used for this
            projection, before file selection. It does not authenticate the runner or prove that the
            results are truthful.
          </p>
        </details>
      </article>
    ))}
  </section>
)}
