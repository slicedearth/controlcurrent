---
import { selectedSnapshot } from "../data";
---

<section
  id="evidence-bundle-panel"
  class="inspector-panel bundle-panel"
  aria-labelledby="bundle-heading"
  data-bcd-version={selectedSnapshot.bcdVersion}
  data-bcd-timestamp={selectedSnapshot.bcdTimestamp}
  data-web-features-version={selectedSnapshot.webFeaturesVersion}
  data-selected-schema-fingerprint={selectedSnapshot.schemaFingerprint}
>
  <div class="planner-intro">
    <span class="eyebrow">Multi-surface, local evidence</span>
    <h2 id="bundle-heading">Assess a bounded evidence bundle</h2>
    <p>
      Bind up to 256 opaque scope entries to 32 assessed surfaces, then combine up to 16 response
      snapshots with optional status, content, redirect, cache, and authentication context; 16 HTML
      documents; 32 bounded local resource bodies; 32 request snapshots; and 16 reduced WebAuthn
      configurations. Markup is parsed without execution or resource loading. Supplied inventory
      entries and resource bytes are reduced locally and omitted from the report.
    </p>
  </div>

  <form id="bundle-form" class="header-form">
    <label for="bundle-block">Evidence bundle JSON</label>
    <textarea
      id="bundle-block"
      name="bundle-block"
      maxlength="2097152"
      rows="24"
      spellcheck="false"
      aria-describedby="bundle-guidance"
      placeholder='{"schemaVersion":4,"name":"Release candidate","identity":{"subject":{},"capture":{}},"scopeInventory":{"schemaVersion":1,"entries":[]},"surfaces":[],"responses":[],"htmlDocuments":[],"resourceBytes":[],"requests":[],"webauthn":[]}'
    ></textarea>
    <p id="bundle-guidance" class="form-message">
      Use opaque application, environment, revision, build, inventory, surface, and producer
      identifiers rather than URLs or personal data. Remove secrets, route locations, page content
      that is not needed for resource analysis, raw WebAuthn challenges, user IDs, and relying-party
      IDs.
    </p>
    <div class="button-row">
      <button type="submit" class="button button--primary">Assess bundle</button>
      <button type="button" class="button" id="load-bundle-example">Load redacted example</button>
      <button type="button" class="button" id="export-bundle" disabled>
        Export reduced report
      </button>
      <button type="button" class="button" id="clear-bundle">Clear</button>
    </div>
    <p id="bundle-message" class="form-message" role="status" aria-live="polite"></p>
  </form>

  <section
    id="bundle-results"
    class="profile-results"
    aria-labelledby="bundle-results-heading"
    hidden
  >
    <div class="section-heading">
      <div>
        <span class="eyebrow">Cross-snapshot assessment</span>
        <h2 id="bundle-results-heading">Reduced evidence report</h2>
      </div>
      <p id="bundle-source"></p>
    </div>
    <div id="bundle-coverage" class="stats-grid"></div>
    <h3>Composite deployment checks</h3>
    <div id="bundle-composites" class="results-list bundle-composites"></div>
    <h3>Control findings</h3>
    <div id="bundle-summary" class="stats-grid"></div>
    <div id="bundle-findings" class="results-list assurance-findings"></div>
    <h3>Evidence inventory</h3>
    <div id="bundle-inventory" class="results-list bundle-inventory"></div>
    <details class="content-card comparison-panel header-form">
      <summary>Compare with a previous reduced report</summary>
      <p>
        Paste an earlier exported report. Comparison requires the same scope-inventory fingerprint,
        application, environment, analyser, and catalogue before comparing normalised findings,
        composites, and declared surface coverage.
      </p>
      <label for="previous-report">Previous reduced report JSON</label>
      <textarea id="previous-report" maxlength="1048576" rows="10" spellcheck="false"></textarea>
      <div class="button-row">
        <button type="button" class="button" id="compare-report">Compare reports</button>
        <button type="button" class="button" id="export-comparison" disabled>
          Export comparison
        </button>
      </div>
      <p id="comparison-message" class="form-message" role="status" aria-live="polite"></p>
      <div id="comparison-results" hidden>
        <div id="comparison-summary" class="stats-grid"></div>
        <div id="comparison-events" class="results-list"></div>
      </div>
    </details>
  </section>
</section>

<script>
  import { SECURITY_CONTROLS } from "../catalogue";
  import type {
    AssuranceReport,
    AssuranceState,
    CompositeAssessment,
    CspMarkupReport,
    EvidenceBundleReport,
    EvidenceReportComparison,
    FetchMetadataReport,
    HtmlResourceReport,
    ResourceVerificationReport,
    WebauthnReport
  } from "../contracts";
  import { compareEvidenceReports } from "../evidence-comparison";
  import { inspectEvidenceBundle } from "../evidence-bundle";
  import { exportEvidenceBundleReport, exportEvidenceReportComparison } from "../export";

  const example = {
    schemaVersion: 4,
    name: "Release candidate",
    identity: {
      subject: {
        applicationId: "example-app",
        environment: "staging",
        revision: "0123456789abcdef0123456789abcdef01234567",
        buildId: "build-42"
      },
      capture: {
        startedAt: "2026-07-20T09:00:00.000Z",
        completedAt: "2026-07-20T09:05:00.000Z",
        producer: {
          kind: "application_ci",
          id: "example-ci",
          version: "1.0.0"
        }
      }
    },
    scopeInventory: {
      schemaVersion: 1,
      name: "Reviewed application route manifest",
      kind: "framework_manifest",
      generatedAt: "2026-07-20T08:55:00.000Z",
      completeness: "complete",
      entries: [
        {
          id: "sign-in",
          disposition: "included"
        }
      ]
    },
    surfaces: [
      {
        id: "sign-in",
        role: "authentication",
        requiredEvidence: ["response", "html", "request", "webauthn"],
        requiredControls: [
          "content-security-policy",
          "csp-nonces",
          "csp-base-uri",
          "csp-frame-ancestors",
          "csp-form-action",
          "subresource-integrity",
          "integrity-policy",
          "cross-origin-opener-policy",
          "cross-origin-embedder-policy",
          "strict-transport-security",
          "x-content-type-options",
          "referrer-policy",
          "samesite-cookies",
          "httponly-cookies",
          "secure-cookie-prefixes",
          "fetch-metadata",
          "webauthn-platform-authenticator",
          "webauthn-prf",
          "webauthn-conditional-mediation"
        ],
        requiredComposites: [
          "strict-csp-candidate",
          "cross-origin-isolation-candidate",
          "cookie-attribute-coverage"
        ]
      }
    ],
    responses: [
      {
        schemaVersion: 2,
        name: "Document response",
        surfaceId: "sign-in",
        context: {
          schemaVersion: 1,
          variantId: "anonymous-html",
          sequence: 0,
          outcome: "final",
          status: 200,
          contentType: "html",
          authentication: "anonymous",
          cache: "miss"
        },
        headers: {
          "Content-Security-Policy":
            "default-src 'self'; script-src 'nonce-AAAAAAAAAAAAAAAAAAAAAA=='; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
          "Integrity-Policy": "blocked-destinations=(script style), endpoints=(integrity-endpoint)",
          "Reporting-Endpoints": 'integrity-endpoint="https://reports.example.invalid/integrity"',
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Referrer-Policy": "strict-origin-when-cross-origin",
          "Set-Cookie": "__Host-session=REDACTED; Path=/; Secure; HttpOnly; SameSite=Lax",
          "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
          "X-Content-Type-Options": "nosniff"
        }
      }
    ],
    htmlDocuments: [
      {
        schemaVersion: 1,
        name: "Document HTML",
        surfaceId: "sign-in",
        html:
          '<script nonce="AAAAAAAAAAAAAAAAAAAAAA==">console.log("local example")</scr' +
          'ipt><link rel="stylesheet" href="/assets/app.css" integrity="sha384-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA">'
      }
    ],
    resourceBytes: [],
    requests: [
      {
        schemaVersion: 1,
        name: "Navigation request",
        surfaceId: "sign-in",
        headers: {
          "Sec-Fetch-Site": "same-origin",
          "Sec-Fetch-Mode": "navigate",
          "Sec-Fetch-Dest": "document",
          "Sec-Fetch-User": "?1"
        }
      }
    ],
    webauthn: [
      {
        schemaVersion: 1,
        name: "Passkey retrieval",
        surfaceId: "sign-in",
        operation: "get",
        authenticatorAttachment: "platform",
        userVerification: "required",
        residentKey: "unspecified",
        attestation: "unspecified",
        mediation: "conditional",
        prfRequested: true
      }
    ]
  } as const;

  const form = document.querySelector<HTMLFormElement>("#bundle-form");
  const panel = document.querySelector<HTMLElement>("#evidence-bundle-panel");
  const input = document.querySelector<HTMLTextAreaElement>("#bundle-block");
  const message = document.querySelector<HTMLElement>("#bundle-message");
  const results = document.querySelector<HTMLElement>("#bundle-results");
  const source = document.querySelector<HTMLElement>("#bundle-source");
  const coverage = document.querySelector<HTMLElement>("#bundle-coverage");
  const summary = document.querySelector<HTMLElement>("#bundle-summary");
  const composites = document.querySelector<HTMLElement>("#bundle-composites");
  const findings = document.querySelector<HTMLElement>("#bundle-findings");
  const inventory = document.querySelector<HTMLElement>("#bundle-inventory");
  const exportButton = document.querySelector<HTMLButtonElement>("#export-bundle");
  const previousReportInput = document.querySelector<HTMLTextAreaElement>("#previous-report");
  const compareButton = document.querySelector<HTMLButtonElement>("#compare-report");
  const comparisonExportButton = document.querySelector<HTMLButtonElement>("#export-comparison");
  const comparisonMessage = document.querySelector<HTMLElement>("#comparison-message");
  const comparisonResults = document.querySelector<HTMLElement>("#comparison-results");
  const comparisonSummary = document.querySelector<HTMLElement>("#comparison-summary");
  const comparisonEvents = document.querySelector<HTMLElement>("#comparison-events");

  if (
    !panel ||
    !form ||
    !input ||
    !message ||
    !results ||
    !source ||
    !coverage ||
    !summary ||
    !composites ||
    !findings ||
    !inventory ||
    !exportButton ||
    !previousReportInput ||
    !compareButton ||
    !comparisonExportButton ||
    !comparisonMessage ||
    !comparisonResults ||
    !comparisonSummary ||
    !comparisonEvents
  ) {
    throw new Error("Evidence bundle controls are unavailable.");
  }

  const controlNames = new Map<string, string>(
    SECURITY_CONTROLS.map((control) => [control.id, control.name] as const)
  );
  const stateLabels: Record<AssuranceState, string> = {
    observed: "Observed",
    missing: "Not observed",
    invalid: "Invalid or ambiguous",
    not_evaluated: "Not evaluated",
    not_applicable: "Not applicable",
    report_only: "Report only",
    inconclusive: "Needs review"
  };
  const compositeLabels: Record<CompositeAssessment["state"], string> = {
    satisfied: "Candidate satisfied",
    review: "Needs review",
    gap: "Gap observed",
    not_evaluated: "Not evaluated",
    not_applicable: "Not applicable"
  };
  const sourceContext = {
    bcdVersion: panel.dataset.bcdVersion ?? "",
    bcdTimestamp: panel.dataset.bcdTimestamp ?? "",
    webFeaturesVersion: panel.dataset.webFeaturesVersion ?? "",
    selectedSchemaFingerprint: panel.dataset.selectedSchemaFingerprint ?? ""
  };
  let latestReport: EvidenceBundleReport | undefined;
  let latestComparison: EvidenceReportComparison | undefined;

  function stat(value: number, label: string): HTMLElement {
    const card = document.createElement("div");
    card.className = "stat-card";
    const count = document.createElement("strong");
    count.textContent = String(value);
    const description = document.createElement("span");
    description.textContent = label;
    card.append(count, description);
    return card;
  }

  function assuranceCard(
    controlId: string,
    state: AssuranceState,
    explanation: string,
    evidence?: string
  ): HTMLElement {
    const article = document.createElement("article");
    article.className = "result-card assurance-card";
    const header = document.createElement("div");
    header.className = "result-card__header";
    const heading = document.createElement("h3");
    heading.textContent = controlNames.get(controlId) ?? controlId;
    const badge = document.createElement("span");
    badge.className = `assurance assurance--${state}`;
    badge.textContent = stateLabels[state];
    header.append(heading, badge);
    const detail = document.createElement("p");
    detail.textContent = explanation;
    article.append(header, detail);
    if (evidence) {
      const evidenceNode = document.createElement("p");
      evidenceNode.className = "assurance-evidence";
      evidenceNode.textContent = evidence;
      article.append(evidenceNode);
    }
    return article;
  }

  function compositeCard(composite: CompositeAssessment): HTMLElement {
    const article = document.createElement("article");
    article.className = "result-card assurance-card";
    const header = document.createElement("div");
    header.className = "result-card__header";
    const heading = document.createElement("h3");
    heading.textContent = composite.name;
    const badge = document.createElement("span");
    badge.className = `composite composite--${composite.state}`;
    badge.textContent = compositeLabels[composite.state];
    header.append(heading, badge);
    const detail = document.createElement("p");
    detail.textContent = composite.summary;
    const requirements = document.createElement("ul");
    for (const requirement of composite.requirements) {
      const item = document.createElement("li");
      item.textContent = requirement;
      requirements.append(item);
    }
    article.append(header, detail, requirements);
    return article;
  }

  function inventoryCard(title: string, description: string, detail: string): HTMLElement {
    const article = document.createElement("article");
    article.className = "result-card assurance-card";
    const heading = document.createElement("h3");
    heading.textContent = title;
    const explanation = document.createElement("p");
    explanation.textContent = description;
    const evidence = document.createElement("p");
    evidence.className = "assurance-evidence";
    evidence.textContent = detail;
    article.append(heading, explanation, evidence);
    return article;
  }

  function responseInventory(report: AssuranceReport): HTMLElement {
    return inventoryCard(
      report.name,
      "Reduced response-header report",
      `${String(report.recognisedHeaderCount)} recognised of ${String(report.inputHeaderCount)} header names`
    );
  }

  function responseContextInventory(
    report: EvidenceBundleReport["responseContexts"][number]
  ): HTMLElement {
    return inventoryCard(
      `Response context · ${report.surfaceId}`,
      `${report.variantId} · ${report.authentication} · ${report.contentType}`,
      `${report.outcome} · ${report.statusClass}${report.status ? ` ${String(report.status)}` : ""} · cache ${report.cache}${report.redirectTarget ? ` · redirect ${report.redirectTarget}` : ""}${report.errorKind ? ` · ${report.errorKind}` : ""}`
    );
  }

  function htmlInventory(report: HtmlResourceReport): HTMLElement {
    return inventoryCard(
      report.name,
      "Non-executing HTML resource inventory",
      `${String(report.protectedResourceCount)} protected of ${String(report.eligibleResourceCount)} eligible resources · algorithms ${report.algorithms.join(", ") || "none"} · ${String(report.parseErrorCount)} parse errors`
    );
  }

  function resourceVerificationInventory(report: ResourceVerificationReport): HTMLElement {
    return inventoryCard(
      "Local resource verification",
      "Resource bodies are hashed in memory and excluded from this reduced report",
      `${String(report.verifiedResourceCount)} verified · ${String(report.mismatchedResourceCount)} mismatched · ${String(report.invalidMetadataCount)} invalid metadata · ${String(report.unmatchedResourceCount)} unmatched`
    );
  }

  function cspMarkupInventory(report: CspMarkupReport): HTMLElement {
    return inventoryCard(
      `CSP and markup · ${report.surfaceId}`,
      "Inline content is matched without retaining nonces, hashes, or source text",
      `${String(report.matchedNonceCount)} nonce · ${String(report.matchedHashCount)} hash · ${String(report.matchedMixedCount)} mixed · ${String(report.unmatchedInlineCount)} unmatched · ${String(report.broadSourceExpressionCount)} broad sources`
    );
  }

  function surfaceInventory(report: EvidenceBundleReport["surfaceCoverage"][number]): HTMLElement {
    return inventoryCard(
      `Expected surface · ${report.surfaceId}`,
      `${report.role} · ${report.state}`,
      report.missingEvidence.length === 0
        ? `Complete: ${report.observedEvidence.join(", ")}`
        : `Missing: ${report.missingEvidence.join(", ")}`
    );
  }

  function scopeInventoryCard(report: EvidenceBundleReport["scopeInventory"]): HTMLElement {
    if (report.state === "absent") {
      return inventoryCard(
        "Scope inventory",
        "No independently produced opaque inventory was supplied",
        "Declared evidence surfaces remain operator-selected and cannot establish route completeness"
      );
    }
    return inventoryCard(
      `Scope inventory · ${report.name}`,
      `${report.kind} · ${report.completeness} · generated ${report.generatedAt}`,
      `${String(report.includedEntries)} included · ${String(report.excludedEntries)} excluded · ${String(report.totalEntries)} total · fingerprint ${report.fingerprint}`
    );
  }

  function surfaceAssessmentInventory(
    report: EvidenceBundleReport["surfaceAssessments"][number]
  ): HTMLElement {
    const observed = report.findings.filter((finding) => finding.state === "observed").length;
    const satisfied = report.composites.filter(
      (composite) => composite.state === "satisfied"
    ).length;
    return inventoryCard(
      `Surface policy · ${report.surfaceId}`,
      `${report.role} · explicit applicability`,
      `${String(observed)} of ${String(report.requiredControls.length)} required controls observed · ${String(satisfied)} of ${String(report.requiredComposites.length)} required composites satisfied`
    );
  }

  function comparisonEventCard(event: EvidenceReportComparison["events"][number]): HTMLElement {
    return inventoryCard(
      event.type.replaceAll("_", " "),
      event.key,
      `${event.beforeState} → ${event.afterState} · ${event.summary}`
    );
  }

  function requestInventory(report: FetchMetadataReport): HTMLElement {
    return inventoryCard(
      report.name,
      "Reduced Fetch Metadata request report",
      `${String(report.recognisedHeaderCount)} recognised request-context headers · ${stateLabels[report.finding.state]}`
    );
  }

  function webauthnInventory(report: WebauthnReport): HTMLElement {
    return inventoryCard(
      report.name,
      `Reduced WebAuthn ${report.operation} configuration`,
      `attachment ${report.configuration.authenticatorAttachment} · user verification ${report.configuration.userVerification} · resident key ${report.configuration.residentKey} · mediation ${report.configuration.mediation} · attestation ${report.configuration.attestation}`
    );
  }

  function render(report: EvidenceBundleReport): void {
    latestReport = report;
    coverage!.replaceChildren(
      stat(report.coverage.responses, "response snapshots"),
      stat(report.coverage.contextualisedResponses, "contextualised responses"),
      stat(report.coverage.responseVariants, "response variants"),
      stat(report.coverage.redirectResponses, "redirect responses"),
      stat(report.coverage.errorResponses, "error responses"),
      stat(report.coverage.authenticatedResponses, "authenticated responses"),
      stat(report.coverage.htmlDocuments, "HTML documents"),
      stat(report.coverage.resourceBytes, "local resource bodies"),
      stat(report.coverage.requests, "request snapshots"),
      stat(report.coverage.webauthn, "WebAuthn configurations"),
      stat(report.coverage.completeSurfaces, "complete expected surfaces"),
      stat(report.coverage.surfaceGaps, "expected surface gaps")
    );
    summary!.replaceChildren(
      stat(report.summary.observed, "controls with consistent observed evidence"),
      stat(report.summary.missing, "controls not observed"),
      stat(report.summary.invalid, "invalid observations"),
      stat(report.summary.reportOnly, "controls present only in report-only policy"),
      stat(report.summary.inconclusive, "controls needing contextual review"),
      stat(report.summary.notEvaluated, "required controls without applicable evidence"),
      stat(report.summary.notApplicable, "controls outside declared surface policy")
    );
    composites!.replaceChildren(...report.composites.map(compositeCard));
    findings!.replaceChildren(
      ...report.findings.map((finding) =>
        assuranceCard(finding.controlId, finding.state, finding.summary, finding.evidence)
      )
    );
    inventory!.replaceChildren(
      scopeInventoryCard(report.scopeInventory),
      ...report.responseReports.map(responseInventory),
      ...report.responseContexts.map(responseContextInventory),
      ...report.htmlReports.map(htmlInventory),
      resourceVerificationInventory(report.resourceVerificationReport),
      ...report.cspMarkupReports.map(cspMarkupInventory),
      ...report.surfaceCoverage.map(surfaceInventory),
      ...report.surfaceAssessments.map(surfaceAssessmentInventory),
      ...report.requestReports.map(requestInventory),
      ...report.webauthnReports.map(webauthnInventory)
    );
    source!.textContent = `${report.name} · ${report.identity.subject.applicationId} · ${report.identity.subject.environment} · revision ${report.identity.subject.revision} · captured ${report.identity.capture.completedAt} by ${report.identity.capture.producer.id} (${report.identity.capture.producer.kind}) · analyser ${report.provenance.analyserVersion} · catalogue ${report.provenance.catalogueVersion} · BCD ${report.provenance.bcdVersion}`;
    exportButton!.disabled = false;
    latestComparison = undefined;
    comparisonExportButton!.disabled = true;
    comparisonResults!.hidden = true;
    comparisonSummary!.replaceChildren();
    comparisonEvents!.replaceChildren();
    comparisonMessage!.textContent = "";
    results!.hidden = false;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      render(await inspectEvidenceBundle(JSON.parse(input!.value) as unknown, sourceContext));
      message!.textContent =
        "Bundle assessed locally. Scope entries, raw HTML, resource locations and bytes, cookies, credentials, and raw WebAuthn identifiers are not present in the report.";
    } catch (error) {
      latestReport = undefined;
      exportButton!.disabled = true;
      results!.hidden = true;
      message!.textContent =
        error instanceof Error ? error.message : "The evidence bundle could not be assessed.";
    }
  });

  document.querySelector("#load-bundle-example")?.addEventListener("click", () => {
    input!.value = JSON.stringify(example, null, 2);
    message!.textContent = "Redacted example loaded. Select Assess bundle to evaluate it.";
  });

  exportButton.addEventListener("click", () => {
    if (!latestReport) return;
    const blob = new Blob([exportEvidenceBundleReport(latestReport)], {
      type: "application/json"
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "controlcurrent-evidence-report.json";
    link.click();
    URL.revokeObjectURL(url);
    message!.textContent = "Reduced evidence report generated locally.";
  });

  compareButton.addEventListener("click", async () => {
    if (!latestReport) return;
    try {
      latestComparison = await compareEvidenceReports(
        JSON.parse(previousReportInput!.value) as unknown,
        latestReport
      );
      comparisonSummary!.replaceChildren(
        stat(latestComparison.summary.regressions, "regressions"),
        stat(latestComparison.summary.resolutions, "resolutions"),
        stat(latestComparison.summary.changed, "other changes"),
        stat(latestComparison.summary.incomparable, "incomparable changes"),
        stat(latestComparison.summary.totalEvents, "total changes")
      );
      comparisonEvents!.replaceChildren(...latestComparison.events.map(comparisonEventCard));
      comparisonExportButton!.disabled = false;
      comparisonResults!.hidden = false;
      comparisonMessage!.textContent = !latestComparison.compatible
        ? latestComparison.compatibilityReasons.join(" ")
        : latestComparison.events.length === 0
          ? "No normalised evidence changes were detected."
          : `${String(latestComparison.summary.totalEvents)} normalised evidence changes detected${latestComparison.summary.truncated ? `; showing the first ${String(latestComparison.summary.emittedEvents)}` : ""}.`;
    } catch (error) {
      latestComparison = undefined;
      comparisonExportButton!.disabled = true;
      comparisonResults!.hidden = true;
      comparisonMessage!.textContent =
        error instanceof Error ? error.message : "The reports could not be compared.";
    }
  });

  comparisonExportButton.addEventListener("click", () => {
    if (!latestComparison) return;
    const blob = new Blob([exportEvidenceReportComparison(latestComparison)], {
      type: "application/json"
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "controlcurrent-evidence-comparison.json";
    link.click();
    URL.revokeObjectURL(url);
    comparisonMessage!.textContent = "Reduced evidence comparison generated locally.";
  });

  document.querySelector("#clear-bundle")?.addEventListener("click", () => {
    input!.value = "";
    latestReport = undefined;
    latestComparison = undefined;
    exportButton!.disabled = true;
    results!.hidden = true;
    coverage!.replaceChildren();
    summary!.replaceChildren();
    composites!.replaceChildren();
    findings!.replaceChildren();
    inventory!.replaceChildren();
    previousReportInput!.value = "";
    comparisonExportButton!.disabled = true;
    comparisonResults!.hidden = true;
    comparisonSummary!.replaceChildren();
    comparisonEvents!.replaceChildren();
    comparisonMessage!.textContent = "";
    message!.textContent = "Bundle input and reduced report cleared.";
    input!.focus();
  });
</script>
