---
import { selectedSnapshot } from "../data";
---

<section
  id="evidence-bundle-panel"
  class="inspector-panel bundle-panel"
  aria-labelledby="bundle-heading"
  data-bcd-version={selectedSnapshot.bcdVersion}
  data-bcd-timestamp={selectedSnapshot.bcdTimestamp}
  data-web-features-version={selectedSnapshot.webFeaturesVersion}
  data-selected-schema-fingerprint={selectedSnapshot.schemaFingerprint}
>
  <div class="planner-intro">
    <span class="eyebrow">Advanced check</span>
    <h2 id="bundle-heading">Review evidence from several pages</h2>
    <p>
      Load a structured JSON file when you need to compare headers, page markup, local resource
      checks, request information, or passkey settings across several parts of an application.
      ControlCurrent analyses the file on this device without running the markup or loading its
      resources. The exported report leaves out the original page content and resource bytes.
    </p>
  </div>

  <form id="bundle-form" class="header-form">
    <label class="evidence-file-drop" id="bundle-drop">
      <strong>Choose or drop a JSON evidence file</strong>
      <span>The file is read on this device, is never uploaded, and may be at most 2 MiB.</span>
      <input id="bundle-file" type="file" accept="application/json,.json" />
    </label>
    <details class="bundle-paste">
      <summary>Or paste and edit JSON</summary>
      <label for="bundle-block">Evidence bundle JSON</label>
      <textarea
        id="bundle-block"
        name="bundle-block"
        maxlength="2097152"
        rows="24"
        spellcheck="false"
        aria-describedby="bundle-guidance"
        placeholder='{"schemaVersion":4,"name":"Release candidate","identity":{"subject":{},"capture":{}},"scopeInventory":{"schemaVersion":1,"entries":[]},"surfaces":[],"responses":[],"htmlDocuments":[],"resourceBytes":[],"requests":[],"webauthn":[]}'
      ></textarea>
    </details>
    <p id="bundle-guidance" class="form-message">
      Use non-identifying labels instead of URLs or personal data. Remove secrets, route locations,
      unnecessary page content, passkey challenges, user IDs, and relying-party IDs before loading
      the file.
    </p>
    <div class="button-row">
      <button type="submit" class="button button--primary">
        Review evidence file
      </button>
      <button type="button" class="button" id="load-bundle-example">
        Load redacted example
      </button>
      <button type="button" class="button" id="export-bundle" disabled>
        Export privacy-reduced report
      </button>
      <button type="button" class="button" id="clear-bundle">
        Clear
      </button>
    </div>
    <p id="bundle-message" class="form-message" role="status" aria-live="polite"></p>
  </form>

  <section
    id="bundle-results"
    class="profile-results"
    aria-labelledby="bundle-results-heading"
    hidden
  >
    <div class="section-heading">
      <div>
        <span class="eyebrow">What the supplied file shows</span>
        <h2 id="bundle-results-heading">Privacy-reduced evidence report</h2>
      </div>
      <p id="bundle-source"></p>
    </div>
    <div id="bundle-coverage" class="stats-grid"></div>
    <h3>Checks that combine several settings</h3>
    <div id="bundle-composites" class="results-list bundle-composites"></div>
    <h3>Security feature results</h3>
    <div id="bundle-summary" class="stats-grid"></div>
    <div id="bundle-findings" class="results-list assurance-findings"></div>
    <h3>Evidence included in the file</h3>
    <div id="bundle-inventory" class="results-list bundle-inventory"></div>
    <details class="content-card comparison-panel header-form">
      <summary>Compare with an earlier report</summary>
      <p>
        Paste an earlier exported report. Both reports must describe the same application,
        environment, included-page list, analysis version, and security-feature catalogue before
        ControlCurrent can compare them safely.
      </p>
      <label for="previous-report">Earlier privacy-reduced report JSON</label>
      <textarea id="previous-report" maxlength="1048576" rows="10" spellcheck="false"></textarea>
      <div class="button-row">
        <button type="button" class="button" id="compare-report">
          Show changes
        </button>
        <button type="button" class="button" id="export-comparison" disabled>
          Export comparison
        </button>
      </div>
      <p id="comparison-message" class="form-message" role="status" aria-live="polite"></p>
      <div id="comparison-results" hidden>
        <div id="comparison-summary" class="stats-grid"></div>
        <div id="comparison-events" class="results-list"></div>
      </div>
    </details>
  </section>
</section>

<script>
  import { initialiseEvidenceBundleInspector } from "../controllers/evidence-bundle";
  initialiseEvidenceBundleInspector();
</script>
