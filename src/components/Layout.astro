---
import "../styles/global.css";
import { selectedSnapshot } from "../data";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} · ControlCurrent`;
const socialImage = new URL("/controlcurrent/og.png", Astro.site);
const contentSecurityPolicy = import.meta.env.DEV
  ? "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; style-src-attr 'none'; img-src 'self' data:; connect-src 'self' ws:; font-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; base-uri 'self'; form-action 'none'"
  : "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self' data:; connect-src 'none'; font-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests";
const localPath = Astro.url.pathname.slice(base.length);
const nav = [
  {
    href: "/planner/",
    label: "Plan",
    number: "01",
    paths: ["/planner/", "/minimums/", "/compare/", "/circuits/"]
  },
  { href: "/assess/", label: "Inspect", number: "02", paths: ["/assess/"] },
  {
    href: "/controls/",
    label: "Reference",
    number: "03",
    paths: ["/controls/", "/matrix/", "/glossary/"]
  },
  {
    href: "/data/",
    label: "Sources",
    number: "04",
    paths: ["/data/", "/changes/", "/browsers/", "/evidence/", "/methodology/"]
  }
];
const section = nav.find((item) => item.paths.some((path) => localPath.startsWith(path)));
const tabs =
  section?.number === "01"
    ? [
        { href: "/planner/", label: "Choose browser versions" },
        { href: "/minimums/", label: "Find minimum versions" },
        { href: "/compare/", label: "Compare plans" },
        { href: "/circuits/", label: "Dependency circuits" }
      ]
    : section?.number === "03"
      ? [
          { href: "/controls/", label: "Feature index" },
          { href: "/matrix/", label: "Support table" },
          { href: "/glossary/", label: "Glossary" }
        ]
      : section?.number === "04"
        ? [
            { href: "/data/", label: "Data & licences" },
            { href: "/changes/", label: "Update log" },
            { href: "/browsers/", label: "Browser releases" },
            { href: "/evidence/", label: "Public tests" },
            { href: "/methodology/", label: "Method" }
          ]
        : [];
const pathWithBase = (path: string) => `${base}${path}`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#102c36" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={pathWithBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ControlCurrent" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="ControlCurrent. Find the browser support gaps." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="ControlCurrent. Find the browser support gaps." />
    <title>{fullTitle}</title>
  </head>
  <body>
    <aside id="embedding-warning" class="embedding-warning" role="alert" hidden>
      <strong>Open ControlCurrent directly</strong>
      <p>
        Interactive planning and assessment are disabled inside an embedded frame. Open this page in
        its own browser tab before entering any redacted evidence.
      </p>
    </aside>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={pathWithBase("/")} aria-label="ControlCurrent home">
          <img
            class="brand-wordmark"
            src={pathWithBase("/logo-reverse.svg")}
            width="420"
            height="96"
            alt=""
          />
          <span class="brand-purpose">
            Browser security
            <br />
            Compatibility &amp; evidence
          </span>
        </a>
        <div class="navigation-shell">
          <button
            class="nav-toggle"
            type="button"
            aria-controls="primary-navigation"
            aria-expanded="false"
          >
            <span class="nav-toggle-label">Menu</span>
            <i aria-hidden="true">
              <span></span>
              <span></span>
            </i>
          </button>
          <nav id="primary-navigation" aria-label="Primary navigation" data-open="false">
            <ul>
              {nav.map((item) => (
                <li>
                  <a
                    href={pathWithBase(item.href)}
                    aria-current={
                      Astro.url.pathname === pathWithBase(item.href) ? "page" : undefined
                    }
                    data-section-active={item === section ? "true" : undefined}
                  >
                    <span class="nav-index" aria-hidden="true">
                      {item.number}
                    </span>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </header>
    {tabs.length > 0 && (
      <div class="section-navigation">
        <nav class="shell section-tabs" aria-label={`${section?.label} pages`}>
          {tabs.map((item) => (
            <a
              href={pathWithBase(item.href)}
              aria-current={localPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    )}
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <div class="shell footer-grid">
        <div>
          <a class="footer-brand" href={pathWithBase("/")}>
            <img
              src={pathWithBase("/logo-reverse.svg")}
              width="230"
              height="53"
              alt="ControlCurrent"
            />
          </a>
          <p>Browser compatibility and supplied security evidence, checked separately.</p>
          <p class="footer-posture">
            Calculations run on your device. No accounts, visitor tracking or evidence uploads.
          </p>
        </div>
        <div>
          <span class="eyebrow">Bundled source versions</span>
          <p>
            MDN browser data {selectedSnapshot.bcdVersion}
            <br />
            Web feature data {selectedSnapshot.webFeaturesVersion}
            <br />
            Catalogue {selectedSnapshot.catalogueVersion}
          </p>
        </div>
        <nav aria-label="Footer navigation">
          <a href={pathWithBase("/data/")}>Data &amp; licensing</a>
          <a href={pathWithBase("/glossary/")}>Plain-English glossary</a>
          <a href={pathWithBase("/privacy/")}>Privacy</a>
          <a href={pathWithBase("/limitations/")}>Limitations</a>
          <a href={pathWithBase("/corrections/")}>Corrections</a>
        </nav>
      </div>
    </footer>
    <script>
      const warning = document.querySelector<HTMLElement>("#embedding-warning");
      if (warning && window.self !== window.top) {
        document.documentElement.dataset.embedding = "blocked";
        warning.hidden = false;
      }

      const navigationShell = document.querySelector<HTMLElement>(".navigation-shell");
      const navigation = document.querySelector<HTMLElement>("#primary-navigation");
      const navigationToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const navigationToggleLabel = document.querySelector<HTMLElement>(".nav-toggle-label");

      if (navigationShell && navigation && navigationToggle && navigationToggleLabel) {
        document.documentElement.dataset.navigation = "enhanced";

        const setNavigationOpen = (open: boolean): void => {
          navigation.dataset.open = String(open);
          navigationToggle.setAttribute("aria-expanded", String(open));
          navigationToggleLabel.textContent = open ? "Close" : "Menu";
        };

        navigationToggle.addEventListener("click", () => {
          setNavigationOpen(navigation.dataset.open !== "true");
        });

        navigation.addEventListener("click", (event) => {
          if (event.target instanceof HTMLAnchorElement) setNavigationOpen(false);
        });

        document.addEventListener("click", (event) => {
          if (event.target instanceof Node && !navigationShell.contains(event.target)) {
            setNavigationOpen(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && navigation.dataset.open === "true") {
            setNavigationOpen(false);
            navigationToggle.focus();
          }
        });

        window.matchMedia("(max-width: 62rem)").addEventListener("change", () => {
          setNavigationOpen(false);
        });
      }
    </script>
  </body>
</html>
