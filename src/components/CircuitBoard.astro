---
import type { SecurityControl } from "../catalogue";
import type { ControlEvaluation } from "../contracts";
import { browserNames, outcomeLabels } from "../format";
import CircuitStatus from "./CircuitStatus.astro";
interface Props {
  control: SecurityControl;
  evaluations: readonly ControlEvaluation[];
}
const { control, evaluations } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
---

<article class="circuit-board" data-circuit-control={control.id}>
  <header class="circuit-board__heading">
    <span class="eyebrow">Output / {control.category}</span>
    <h2>{control.name}</h2>
    <p>{control.summary}</p>
  </header>
  <div class="trace-head" aria-hidden="true">
    <span>Browser / version</span>
    <span>Recorded support</span>
  </div>
  <div class="browser-terminals" role="group" aria-label="Current browser support">
    {evaluations.map((evaluation, index) => (
      <button
        type="button"
        class="browser-terminal"
        data-circuit-browser={evaluation.browser}
        data-browser-name={browserNames[evaluation.browser]}
        data-version={evaluation.minimumVersion}
        data-explanation={evaluation.explanation}
        data-outcome={evaluation.outcome}
        data-outcome-label={outcomeLabels[evaluation.outcome]}
        aria-pressed="false"
        disabled
      >
        <span class="terminal-number" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <span class="terminal-name">
          <span>{browserNames[evaluation.browser]}</span>
          <strong>{evaluation.minimumVersion}</strong>
        </span>
        <CircuitStatus outcome={evaluation.outcome} />
        <span class="terminal-contact" aria-hidden="true">
          ↗
        </span>
      </button>
    ))}
  </div>
  <aside class="circuit-readout" aria-live="polite" aria-atomic="true">
    <span class="readout-contact" aria-hidden="true"></span>
    <div>
      <h3 data-reading-heading>Open a browser reading.</h3>
      <p data-reading-body>
        Select a track above for the recorded reason. Qualifications and gaps stay visible.
      </p>
    </div>
  </aside>
  <a class="circuit-source-link" href={`${base}/controls/${control.id}/`}>
    Source paths &amp; implementation notes <span aria-hidden="true">↗</span>
  </a>
</article>
