<section class="plan-library content-card" aria-labelledby="plan-library-heading">
  <div class="section-heading">
    <div>
      <span class="eyebrow">On this device</span>
      <h2 id="plan-library-heading">Keep a few plans</h2>
    </div>
    <p>Up to 12 named plans. Saving is optional. Header input and evidence are never included.</p>
  </div>
  <div class="library-fields">
    <label>
      <span>Saved plans</span>
      <select id="saved-plan">
        <option value="">Choose a saved plan</option>
      </select>
    </label>
    <label>
      <span>New name for selected plan</span>
      <input id="saved-plan-name" maxlength="80" />
    </label>
  </div>
  <div class="button-row">
    <button type="button" class="button" id="library-save">
      Save current as a new plan
    </button>
    <button type="button" class="button" id="library-load">
      Load selected
    </button>
    <button type="button" class="button" id="library-duplicate">
      Duplicate selected
    </button>
    <button type="button" class="button" id="library-rename">
      Rename selected
    </button>
    <button type="button" class="button" id="library-export">
      Export selected
    </button>
    <button type="button" class="button" id="library-delete">
      Delete selected
    </button>
  </div>
  <p id="library-status" class="form-message" role="status" aria-live="polite"></p>
</section>
