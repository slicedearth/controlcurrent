---
import type { Outcome } from "../contracts";
import { outcomeLabels } from "../format";

interface Props {
  outcome: Outcome;
  detail?: string;
}

const { outcome, detail } = Astro.props;
---

<span class:list={["outcome", `outcome--${outcome}`]} title={detail}>
  <span class="outcome__dot" aria-hidden="true"></span>
  <span class="outcome__label">{outcomeLabels[outcome]}</span>
</span>
