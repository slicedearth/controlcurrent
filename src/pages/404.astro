---
import Layout from "../components/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
---

<Layout title="Page not found" description="The requested ControlCurrent page was not found.">
  <header class="shell page-header">
    <span class="eyebrow">404</span>
    <h1>Page not found</h1>
    <p>The page may have moved, or the URL may be incomplete.</p>
    <p><a class="button button--primary" href={`${base}/`}>Return to overview</a></p>
  </header>
</Layout>
