---
import Layout from "../components/Layout.astro";
import OutcomeBadge from "../components/OutcomeBadge.astro";
import { SECURITY_CONTROLS } from "../catalogue";
import { currentEvaluation, currentProfile, selectedSnapshot } from "../data";
import { browserNames } from "../format";

const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
---

<Layout
  title="Compatibility matrix"
  description="A browser-by-browser matrix for the current ControlCurrent security control catalogue."
>
  <header class="shell page-header">
    <span class="eyebrow">BCD {selectedSnapshot.bcdVersion}</span>
    <h1>Current-channel compatibility matrix</h1>
    <p>
      This table evaluates the desktop release channels identified as current in the selected BCD
      package. Use the planner for your own explicit minimum versions.
    </p>
  </header>
  <section class="shell section">
    <div
      class="table-wrap"
      role="region"
      aria-label="Security control compatibility matrix"
      tabindex="0"
    >
      <table>
        <thead>
          <tr>
            <th scope="col">Control</th>
            {
              currentProfile.baselines.map((baseline) => (
                <th scope="col">
                  {browserNames[baseline.browser]}
                  <br />
                  <small>{baseline.minimumVersion}</small>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            SECURITY_CONTROLS.map((control) => (
              <tr>
                <th scope="row">
                  <a href={`${base}/controls/${control.id}/`}>{control.shortName}</a>
                </th>
                {(currentEvaluation.results[control.id] ?? []).map((evaluation) => (
                  <td>
                    <OutcomeBadge outcome={evaluation.outcome} detail={evaluation.explanation} />
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="callout">
      <strong>Compatibility is not configuration assurance.</strong>
      A green result means the mapped browser feature is available without a qualification recorded in
      BCD at that minimum. It does not inspect an application or prove effective enforcement.
    </div>
  </section>
</Layout>
