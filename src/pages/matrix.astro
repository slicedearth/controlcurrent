---
import Layout from "../components/Layout.astro";
import OutcomeBadge from "../components/OutcomeBadge.astro";
import { SECURITY_CONTROLS } from "../catalogue";
import { currentEvaluation, currentProfile, selectedSnapshot } from "../data";
import { browserNames } from "../format";

const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
---

<Layout
  title="Browser support table"
  description="Compare support for each security feature across current desktop and mobile browsers."
>
  <header class="shell page-header">
    <span class="eyebrow">MDN browser data {selectedSnapshot.bcdVersion}</span>
    <h1>Compare security-feature support across browsers</h1>
    <p>
      This table uses the current version of each browser recorded in the selected MDN data. To
      check the older versions your own website supports, use the browser planner.
    </p>
  </header>
  <section class="shell section">
    <div
      class="table-wrap"
      role="region"
      aria-label="Security control compatibility matrix"
      tabindex="0"
    >
      <table>
        <thead>
          <tr>
            <th scope="col">Control</th>
            {
              currentProfile.baselines.map((baseline) => (
                <th scope="col">
                  {browserNames[baseline.browser]}
                  <br />
                  <small>{baseline.minimumVersion}</small>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            SECURITY_CONTROLS.map((control) => (
              <tr>
                <th scope="row">
                  <a href={`${base}/controls/${control.id}/`}>{control.shortName}</a>
                </th>
                {(currentEvaluation.results[control.id] ?? []).map((evaluation) => (
                  <td>
                    <OutcomeBadge outcome={evaluation.outcome} detail={evaluation.explanation} />
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="callout">
      <strong>“Works” does not mean “securely configured”.</strong>
      It means the browser feature is supported without a known limitation in the selected MDN data. ControlCurrent
      has not inspected your website or tested whether the feature is enforced.
    </div>
  </section>
</Layout>
