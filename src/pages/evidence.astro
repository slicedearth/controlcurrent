---
import Layout from "../components/Layout.astro";
import WptSnapshot from "../components/WptSnapshot.astro";
import WptSourceLinks from "../components/WptSourceLinks.astro";
import { getControl } from "../catalogue";
import { WPT_EVIDENCE, getWptSourceReview } from "../wpt-evidence";

const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const mappedCount = WPT_EVIDENCE.filter((mapping) => mapping.state === "mapped").length;
const reviews = WPT_EVIDENCE.map(getWptSourceReview);
const revisions = new Set(reviews.map((review) => review.revision));
const latestReview = reviews
  .map((review) => review.reviewedOn)
  .sort()
  .at(-1);
---

<Layout
  title="Public browser tests"
  description="See which public Web Platform Tests exercise behaviour related to each security feature."
>
  <header class="shell page-header">
    <span class="eyebrow">The test index</span>
    <h1>Public browser tests.</h1>
    <p>
      Where possible, ControlCurrent links each security feature to the relevant Web Platform Tests.
      These public tests help show how browsers are checked against web standards. They do not test
      or certify your website.
    </p>
  </header>

  <section class="shell stats-grid evidence-stats" aria-label="Web Platform Tests mapping summary">
    <div class="stat-card">
      <strong>{mappedCount}</strong>
      <span>security features with a direct test link</span>
    </div>
    <div class="stat-card">
      <strong>{WPT_EVIDENCE.length - mappedCount}</strong>
      <span>features without a reliable direct test link</span>
    </div>
    <div class="stat-card">
      <strong>{revisions.size}</strong>
      <span>pinned test-source revisions</span>
    </div>
    <div class="stat-card">
      <strong>{latestReview}</strong>
      <span>latest mapping review; individual dates below</span>
    </div>
  </section>

  <div class="shell section">
    <WptSnapshot />
  </div>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Feature-by-feature links</span>
          <h2>Relevant browser tests</h2>
        </div>
        <p>
          “Reviewed test source” opens the exact version checked for this site. “Latest public
          results” opens the live results, which can change over time.
        </p>
      </div>

      <div class="evidence-list">
        {WPT_EVIDENCE.map((mapping) => {
          const control = getControl(mapping.controlId);
          if (!control) throw new Error(`Missing control ${mapping.controlId}`);
          return (
            <article class="content-card evidence-card">
              <div class="card-topline">
                <span class="category">{control.category}</span>
                <span class={`evidence-state evidence-state--${mapping.state}`}>
                  {mapping.state === "mapped" ? "Test link available" : "No exact test link"}
                </span>
              </div>
              <h3>
                <a href={`${base}/controls/${control.id}/`}>{control.name}</a>
              </h3>
              <p>{mapping.scope}</p>
              <WptSourceLinks mapping={mapping} />
              <p class="evidence-limit">
                <strong>Limit:</strong> {mapping.limitation}
              </p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell detail-grid">
      <div>
        <span class="eyebrow">How the information fits together</span>
        <h2>Browser support, public tests, and your own evidence answer different questions</h2>
        <p>
          MDN data records which browsers support a feature. Web Platform Tests exercise standard
          browser behaviour. ControlCurrent can also check configuration information that you
          supply. None of these can see the full security design of a production website.
        </p>
      </div>
      <div class="content-card">
        <h3>Why there is no simple test score</h3>
        <p>
          ControlCurrent does not turn live public test results into a percentage. The selected
          tests, browser version, test infrastructure, expected failures, and incomplete runs all
          need context that a single score would hide.
        </p>
        <p>
          Some Web Platform Tests (WPT) also require automation and cannot be run in an ordinary
          browser session.
        </p>
      </div>
    </div>
  </section>
</Layout>
