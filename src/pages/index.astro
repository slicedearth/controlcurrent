---
import Layout from "../components/Layout.astro";
import SupportCircuit from "../components/SupportCircuit.astro";
import { selectedSnapshot } from "../data";
import { formatDate } from "../format";
import "../styles/home.css";
const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
---

<Layout
  title="Find the browser support gaps"
  description="Turn through 30 browser security protections. See which browsers support them, read the exceptions, and plan the versions your site needs."
>
  <SupportCircuit />
  <div class="shell bench-page">
    <nav class="bench-actions" aria-label="Continue your review">
      <a class="button" href={`${base}/planner/`}>
        <span>
          <small>01 / PLAN</small>
          <strong>Set your browser minimums</strong>
          <span>Check the oldest versions your site supports.</span>
        </span>
        <span class="action-contact" aria-hidden="true">
          ↗
        </span>
      </a>
      <a class="button" href={`${base}/assess/`}>
        <span>
          <small>02 / INSPECT</small>
          <strong>Check supplied headers</strong>
          <span>Read configuration evidence on your device.</span>
        </span>
        <span class="action-contact" aria-hidden="true">
          ↗
        </span>
      </a>
    </nav>
  </div>
  <section class="source-strip" aria-label="Sources for this edition">
    <div class="shell source-strip__inner">
      <span class="eyebrow">Source record</span>
      <dl>
        <div>
          <dt>MDN browser data</dt>
          <dd>{selectedSnapshot.bcdVersion}</dd>
        </div>
        <div>
          <dt>Web feature data</dt>
          <dd>{selectedSnapshot.webFeaturesVersion}</dd>
        </div>
        <div>
          <dt>Source date</dt>
          <dd>
            <time datetime={selectedSnapshot.bcdTimestamp}>
              {formatDate(selectedSnapshot.bcdTimestamp)}
            </time>
          </dd>
        </div>
      </dl>
      <a href={`${base}/data/`}>Source notes ↗</a>
    </div>
  </section>
  <div class="shell bench-footnote">
    <p>
      Browser compatibility, supplied evidence and runtime behaviour answer different questions.
      ControlCurrent keeps them separate.{" "}
      <a href={`${base}/limitations/`}>Read the limits of each check.</a>
    </p>
    <p>
      No accounts. No visitor tracking.
      <br />
      No website scans or evidence uploads.
    </p>
  </div>
</Layout>
