---
import Layout from "../components/Layout.astro";
import Planner from "../components/Planner.astro";
---

<Layout
  title="Plan browser support"
  description="Choose the oldest browsers your website supports and see which security features will work or need a fallback."
>
  <header class="shell page-header">
    <span class="eyebrow">The browser planner</span>
    <h1>Set your browser minimums.</h1>
    <p>
      Set the oldest browser versions you support, then check which security features they can use.
      Known limitations and missing data stay in the results. Your plan stays on this device.
    </p>
  </header>
  <div class="shell">
    <Planner />
  </div>
</Layout>
