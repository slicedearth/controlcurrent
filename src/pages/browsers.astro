---
import Layout from "../components/Layout.astro";
import { currentProfile, selectedSnapshot } from "../data";
import { browserNames, formatDate } from "../format";
---

<Layout
  title="Browser releases"
  description="The recent browser versions recorded in the MDN data used by ControlCurrent."
>
  <header class="shell page-header">
    <span class="eyebrow">Browser releases</span>
    <h1>The versions in the record.</h1>
    <p>
      These versions and dates come from MDN browser data. ControlCurrent does not detect your
      installed browser, estimate browser popularity, or decide which versions your organisation
      should support.
    </p>
  </header>
  <section class="shell section">
    <div class="control-grid">
      {currentProfile.baselines.map((baseline) => {
        const browser = selectedSnapshot.browsers[baseline.browser];
        const recent = [...browser.releases].reverse().slice(0, 8);
        return (
          <article class="content-card">
            <span class="eyebrow">{browser.id}</span>
            <h2>{browserNames[baseline.browser]}</h2>
            <p>
              Current release in this MDN data: <strong>{baseline.minimumVersion}</strong>
            </p>
            <ul>
              {recent.map((release) => (
                <li>
                  {release.version} · {release.status}
                  {release.releaseDate ? ` · ${formatDate(release.releaseDate)}` : ""}
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
