{
  "name": "controlcurrent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Security-control compatibility planning from attributed browser support data",
  "license": "MIT",
  "author": "slicedearth",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.17.0 <13"
  },
  "scripts": {
    "dev": "astro dev",
    "generate": "tsx tools/generate.ts",
    "generate:check": "tsx tools/generate.ts --check",
    "lint": "eslint src tools tests e2e --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json",
    "check": "astro check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "npm run generate:check && astro build",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "audit:public": "tsx tools/audit-public.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run check && npm test && npm run build && npm run audit:public"
  },
  "dependencies": {
    "@mdn/browser-compat-data": "8.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "4.1.10",
    "astro": "7.1.3",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false
  }
}
